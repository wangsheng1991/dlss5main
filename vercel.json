{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/gpu/:match*",
      "destination": "/api/health?retired_provider_proxy=1"
    },
    {
      "source": "/api/oss/:match*",
      "destination": "/api/health?retired_provider_proxy=1"
    },
    {
      "source": "/video-downloader",
      "destination": "/api/health?retired_media=1"
    },
    {
      "source": "/zh/video-downloader",
      "destination": "/api/health?retired_media=1"
    },
    {
      "source": "/api/me/:route",
      "destination": "/api/me/[route]"
    },
    {
      "source": "/api/image-edit/jobs/:id",
      "destination": "/api/image-edit/jobs/[id]"
    },
    {
      "source": "/api/image-edit/results/:id",
      "destination": "/api/image-edit/results/[id]"
    },
    {
      "source": "/api/billing/:route",
      "destination": "/api/billing/[route]"
    },
    {
      "source": "/zh",
      "destination": "/zh/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/en/blog",
      "destination": "/en/blog/index.html"
    },
    {
      "source": "/en/blog/:slug",
      "destination": "/en/blog/:slug/index.html"
    },
    {
      "source": "/zh/blog",
      "destination": "/zh/blog/index.html"
    },
    {
      "source": "/zh/blog/:slug",
      "destination": "/zh/blog/:slug/index.html"
    },
    {
      "source": "/store",
      "destination": "/store/index.html"
    },
    {
      "source": "/image-upscaler",
      "destination": "/image-upscaler/index.html"
    },
    {
      "source": "/image-quality-enhancer",
      "destination": "/image-quality-enhancer/index.html"
    },
    {
      "source": "/visual-enhancer",
      "destination": "/visual-enhancer/index.html"
    },
    {
      "source": "/zh/visual-enhancer",
      "destination": "/zh/visual-enhancer/index.html"
    },
    {
      "source": "/unblur-image",
      "destination": "/unblur-image/index.html"
    },
    {
      "source": "/es/mejorar-calidad-imagen",
      "destination": "/es/mejorar-calidad-imagen/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/guides",
      "destination": "/guides/index.html"
    },
    {
      "source": "/what-is-dlss-5",
      "destination": "/what-is-dlss-5/index.html"
    },
    {
      "source": "/vs/dlss-5-vs-dlss-4-5",
      "destination": "/vs/dlss-5-vs-dlss-4-5/index.html"
    },
    {
      "source": "/vs/dlss-5-vs-fsr-4",
      "destination": "/vs/dlss-5-vs-fsr-4/index.html"
    },
    {
      "source": "/system-requirements",
      "destination": "/system-requirements/index.html"
    },
    {
      "source": "/status",
      "destination": "/status/index.html"
    },
    {
      "source": "/zh/guides",
      "destination": "/zh/guides/index.html"
    },
    {
      "source": "/zh/what-is-dlss-5",
      "destination": "/zh/what-is-dlss-5/index.html"
    },
    {
      "source": "/zh/vs/dlss-5-vs-dlss-4-5",
      "destination": "/zh/vs/dlss-5-vs-dlss-4-5/index.html"
    },
    {
      "source": "/zh/vs/dlss-5-vs-fsr-4",
      "destination": "/zh/vs/dlss-5-vs-fsr-4/index.html"
    },
    {
      "source": "/zh/system-requirements",
      "destination": "/zh/system-requirements/index.html"
    },
    {
      "source": "/zh/status",
      "destination": "/zh/status/index.html"
    },
    {
      "source": "/video-studio",
      "destination": "/video-studio/index.html"
    },
    {
      "source": "/zh/video-studio",
      "destination": "/zh/video-studio/index.html"
    },
    {
      "source": "/video-studio/:tool",
      "destination": "/video-studio/:tool/index.html"
    },
    {
      "source": "/zh/video-studio/:tool",
      "destination": "/zh/video-studio/:tool/index.html"
    },
    {
      "source": "/video-understanding",
      "destination": "/video-understanding/index.html"
    },
    {
      "source": "/zh/video-understanding",
      "destination": "/zh/video-understanding/index.html"
    },
    {
      "source": "/image-to-video",
      "destination": "/image-to-video/index.html"
    },
    {
      "source": "/zh/image-to-video",
      "destination": "/zh/image-to-video/index.html"
    },
    {
      "source": "/zh/video-upscaler",
      "destination": "/zh/video-upscaler/index.html"
    },
    {
      "source": "/vs/topaz-video-upscaling",
      "destination": "/vs/topaz-video-upscaling/index.html"
    },
    {
      "source": "/zh/vs/topaz-video-upscaling",
      "destination": "/zh/vs/topaz-video-upscaling/index.html"
    },
    {
      "source": "/frame-interpolation",
      "destination": "/frame-interpolation/index.html"
    },
    {
      "source": "/zh/frame-interpolation",
      "destination": "/zh/frame-interpolation/index.html"
    },
    {
      "source": "/video-highlights",
      "destination": "/video-highlights/index.html"
    },
    {
      "source": "/zh/video-highlights",
      "destination": "/zh/video-highlights/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/examples/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/blog/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "functions": {
    "api/image-edit/samples.ts": {
      "maxDuration": 60
    },
    "api/billing/[route].ts": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/en/blog",
      "destination": "/blog",
      "statusCode": 301
    },
    {
      "source": "/en/blog/dlss-5-online-image-upscaler-guide",
      "destination": "/blog/dlss-5-online-image-upscaler-guide",
      "statusCode": 301
    },
    {
      "source": "/en/blog/dlss-5-gpt-6-astra-ai-rendering-workflow-2026",
      "destination": "/blog/dlss-5-gpt-6-astra-ai-rendering-workflow-2026",
      "statusCode": 301
    },
    {
      "source": "/en/blog/dlss5-vs-dlss4-vs-fsr4-comparison-2026",
      "destination": "/blog/dlss5-vs-dlss4-vs-fsr4-comparison-2026",
      "statusCode": 301
    },
    {
      "source": "/en/blog/seedance-2-5-video-super-resolution-cost-guide-2026",
      "destination": "/blog/seedance-2-5-video-super-resolution-cost-guide-2026",
      "statusCode": 301
    },
    {
      "source": "/en/blog/dlss-5-latest-news-september-2026",
      "destination": "/blog/dlss-5-latest-news-september-2026",
      "statusCode": 301
    },
    {
      "source": "/en/blog/what-is-dlss-5-neural-rendering-guide",
      "destination": "/blog/what-is-dlss-5-neural-rendering-guide",
      "statusCode": 301
    },
    {
      "source": "/en/blog/crimson-desert-pc-optimization-dlss-fsr-guide-2026",
      "destination": "/blog/crimson-desert-pc-optimization-dlss-fsr-guide-2026",
      "statusCode": 301
    },
    {
      "source": "/en/blog/best-ai-image-upscaler-2026-comparison",
      "destination": "/blog/best-ai-image-upscaler-2026-comparison",
      "statusCode": 301
    },
    {
      "source": "/en/blog/dlss5-artistic-vision-debate-honest-assessment",
      "destination": "/blog/dlss5-artistic-vision-debate-honest-assessment",
      "statusCode": 301
    }
  ]
}
