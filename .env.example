# DLSS 5 Environment Variables

# API Key for GPU/OSS backend services
VITE_API_KEY="your-api-key-here"

# Default seed for image generation (optional, defaults to 42)
VITE_DEFAULT_SEED="42"

# Optional API origin for a custom backend (leave empty to use same-origin /api routes).
VITE_GENERATION_API_BASE=""

# Server-only FAL credential. Do not prefix this with VITE_ or expose it to the browser.
FAL_API_KEY=""

# Firebase REST quota target (must remain the named database used by this app).
FIREBASE_PROJECT_ID="gen-lang-client-0654303469"
FIREBASE_DATABASE_ID="ai-studio-01314581-d2f2-4ede-8d5b-93cb8071dc7f"
FIREBASE_WEB_API_KEY=""

# Server-only AlphaNet image API (never prefix with VITE_)
ALPHANET_BASE_URL="https://dashboard.alphanetplus.com"
ALPHANET_API_KEY=""

# Server-only Firebase Admin credentials for atomic quota/job transactions.
# Store as one-line JSON in Vercel, never in the browser or repository.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Server-only Stripe billing (never prefix with VITE_).
# Sandbox: use the test-mode secret key (sk_test_...) and the whsec_... of the /api/billing/webhook endpoint.
# scripts/stripe-setup.mjs creates that endpoint and prints the signing secret.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional: pre-created recurring prices. Without them checkout sends an inline monthly price from src/config/plans.ts.
STRIPE_PRICE_PRO=""
STRIPE_PRICE_TEAM=""
# Optional absolute site origin used in Stripe redirects (defaults to the request host).
PUBLIC_SITE_URL=""

# Optional comma-separated admin emails for /api/admin/overview.
ADMIN_EMAILS=""
# Optional support address shown on the pricing page.
MEMBERSHIP_CONTACT_EMAIL=""
